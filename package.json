{
  "name": "waferlens",
  "private": true,
  "version": "0.1.0",
  "description": "WaferLens: inference performance operations. Demo on simulated seed data.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @waferlens/web",
    "build": "npm run build -w @waferlens/web",
    "start": "npm run start -w @waferlens/web",
    "typecheck": "tsc -p packages/tsconfig.json --noEmit && npm run typecheck -w @waferlens/web",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
